NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Optional second browser origin when one API serves both local and deployed clients.
WEB_ORIGIN_LOCAL=
PUBLIC_API_URL=https://your-public-api.example.com
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://your-public-api.example.com/api/social-accounts/instagram/callback
# For local sign-in, use your HTTPS tunnel to localhost:4000 and allowlist this exact URL in Meta.
INSTAGRAM_REDIRECT_URI_LOCAL=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://your-public-api.example.com/api/social-accounts/facebook/callback
FACEBOOK_REDIRECT_URI_LOCAL=
SOCIAL_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_GRAPH_API_VERSION=v26.0
FACEBOOK_GRAPH_API_VERSION=v26.0
PRODUCT_NAME=United Technologies
# Tavily Search API key for in-dashboard company website discovery.
TAVILY_API_KEY=
APIFY_API_TOKEN=
# Optional JSON object to override the verified default public-data Actors.
# Inputs are bounded to 10 items per profile; Actor usage may incur Apify charges.
# Shape: {"Instagram":{"actorId":"owner/actor","inputTemplate":{},"fields":{"url":"...","caption":"..."}}}
APIFY_COMPETITOR_ACTORS={}
# YouTube Data API public video/channel statistics.
YOUTUBE_DATA_API_KEY=
# X API bearer token for recent public account posts and metrics.
X_API_BEARER_TOKEN=
# Cloudflare Workers AI requires an account ID and API token with Workers AI permissions.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_REFERENCE_IMAGE_MODEL=@cf/runwayml/stable-diffusion-v1-5-img2img
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Configure a generic SMTP server, or use Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RESEND_API_KEY=
EMAIL_FROM=
PIPER_EXECUTABLE=piper
PIPER_VOICE_MODEL=
PIPER_MULTISPEAKER_VOICE_MODEL=
PEXELS_API_KEY=
MAGIC_HOUR_API_KEY=
# Optional second Magic Hour account. The Video Studio shows both balances together and picks an account with credits for each new job.
MAGIC_HOUR_API_KEY_2=
CREATOMATE_API_KEY=
SUPER_ADMIN_EMAIL=
DATABASE_URL=mysql://root:@localhost:3306/united_technologies
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
COOKIE_SECURE=false
SEED_ADMIN_EMAIL=admin@united-technologies.local
SEED_ADMIN_PASSWORD=
